{
  "manifest_version": 3,
  "name": "Universal Form Auto-Fill Assistant",
  "version": "1.0.0",
  "description": "Detects fields on any web form and one-click fills them from your saved profile.",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Auto-Fill Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://docs.google.com/forms/*"],
      "js": ["content-scripts/filler.js", "content-scripts/detector.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content-scripts/filler.js", "content-scripts/google-forms.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
